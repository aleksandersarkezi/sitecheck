# Copy to .env on the server and fill in. Never commit .env.

# Domain pointing at this server (A/AAAA record) and the email Let's Encrypt
# uses for expiry notices.
SITE_DOMAIN=sitecheck.example.com
ACME_EMAIL=you@example.com

# Which image to run. The deploy workflow sets this to the commit SHA so every
# deploy is pinned and easy to roll back.
IMAGE_TAG=latest

# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL
# Slack: an "Incoming Webhook" URL works too. Leave empty to only log alerts.
SITECHECK_WEBHOOK_URL=

# How often the monitor runs, in seconds (21600 = every 6 hours).
MONITOR_INTERVAL_SECONDS=21600

# Fresh checks per visitor IP per minute (cached results don't count).
SITECHECK_RATE_LIMIT=6
SITECHECK_CACHE_SECONDS=600
SITECHECK_MAX_CONCURRENT=4

LOG_LEVEL=INFO

# Public uptime page (e.g. your free UptimeRobot status page). The Caddyfile
# redirects status.<ROOT_DOMAIN> here. Leave empty to send it to the home page.
STATUS_PAGE_URL=
