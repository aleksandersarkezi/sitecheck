{
	email {$ACME_EMAIL}
}

# Caddy gets and renews the Let's Encrypt certificate on its own and
# redirects http:// to https:// automatically.
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
		defer
	}

	# Prometheus metrics are for the server only, never the public internet.
	@internal path /metrics /metrics/*
	respond @internal 404

	reverse_proxy app:8000 {
		health_uri /healthz
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}

# Personal home page: plain static files from ./site, served by Caddy itself.
# ROOT_DOMAIN can be set in .env; it defaults to the owner's domain.
{$ROOT_DOMAIN:aleksandersarkezi.com} {
	encode zstd gzip
	root * /srv/site

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' https://{$SITE_DOMAIN}; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Fonts, images and versioned libraries rarely change; HTML, CSS and
	# main.js are revalidated every time so a deploy shows up immediately.
	@assets path /fonts/* /og.png /favicon.svg /me.jpg /sitecheck.jpg /js/vendor/*
	header @assets Cache-Control "public, max-age=604800"
	@pages not path /fonts/* /og.png /favicon.svg /me.jpg /sitecheck.jpg /js/vendor/*
	header @pages Cache-Control "no-cache"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

www.{$ROOT_DOMAIN:aleksandersarkezi.com} {
	redir https://{$ROOT_DOMAIN:aleksandersarkezi.com}{uri} permanent
}

# status.<domain> is only a short, memorable link to the public uptime page,
# which is hosted by the uptime monitoring service itself.
status.{$ROOT_DOMAIN:aleksandersarkezi.com} {
	redir {$STATUS_PAGE_URL:https://aleksandersarkezi.com/} 302
}
