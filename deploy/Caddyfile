{
	email {$ACME_EMAIL}
}

# Caddy gets and renews the Let's Encrypt certificate on its own and
# redirects http:// to https:// automatically.
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
		defer
	}

	# Prometheus metrics are for the server only, never the public internet.
	@internal path /metrics /metrics/*
	respond @internal 404

	reverse_proxy app:8000 {
		health_uri /healthz
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}
